   "source": [
    "# Krones Automation Production Workflow\n",
    "\n",
    "This notebook serves as a thin execution interface for the Krones Partner Portal automation.\n",
    "The core logic lives strictly in the `krones_automation/` python package.\n",
    "\n",
    "## 1. Setup & Environment\n",
    "Run this block to ensure dependencies are loaded."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "!{sys.executable} -m pip install -r requirements.txt\n",
    "import asyncio\n",
    "from pathlib import Path\n",
    "import nest_asyncio\n",
    "\n",
    "# Required to run asyncio in Jupyter notebooks\n",
    "nest_asyncio.apply()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Execute Automation\n",
    "\n",
    "This cell will:\n",
    "1. Launch an interactive browser.\n",
    "2. Pause and wait for you to log in.\n",
    "3. Once logged in and navigated to the 3D Requests table, the pipeline will automatically discover, download, and package the requests."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from krones_automation.pipeline import Pipeline\n",
    "from krones_automation.sap_client import SAPClient\n",
    "\n",
    "async def run_production():\n",
    "    client = SAPClient(headless=False)\n",
    "    await client.start()\n",
    "    \n",
    "    try:\n",
    "        # The automation opens Krones portal and waits for user login.\n",
    "        # Since this requires live credentials, we pause and let the user interact.\n",
    "        await client.authenticate_and_navigate(\"https://partner.krones.com/irj/portal\")\n",
    "        \n",
    "        # Execute pipeline against the active SAP page\n",
    "        pipeline = Pipeline()\n",
    "        await pipeline.run(page=client.page)\n",
    "        \n",
    "        print(\"Pipeline Execution Complete. Check Output Folders.\")\n",
    "    except Exception as e:\n",
    "        print(f\"An error occurred during execution: {e}\")\n",
    "    finally:\n",
    "        await client.close()\n",
    "\n",
    "# Start the async loop\n",
    "asyncio.run(run_production())"
   ]
  }
 ],
