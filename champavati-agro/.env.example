DATABASE_URL="postgresql://user:password@localhost:5432/champavati_agro?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# "filesystem" (default, local dev only) or "vercel-blob" (required on
# Vercel — serverless functions have no persistent disk, so the filesystem
# provider's .uploads/ folder would not survive between requests there).
STORAGE_PROVIDER="filesystem"
# The filesystem provider writes to a fixed .uploads/ directory at the repo
# root (not configurable via env — kept as a static literal path so Next's
# build-time file tracer can scope to it correctly). It's a private
# directory OUTSIDE public/, since uploaded photos are access-controlled and
# must never be served as static files — only through
# app/api/photos/[id]/route.ts.

# Only needed when STORAGE_PROVIDER="vercel-blob". On Vercel, linking a Blob
# store to the project injects this automatically — set it manually only
# for local testing against a real Blob store. Photos are stored with
# access:"private" (no public URL); every read still goes through this
# token from the server, preserving the same access-controlled model as the
# filesystem provider.
BLOB_READ_WRITE_TOKEN=""

AADHAAR_ENC_KEY="generate-32-byte-hex-key-with-openssl-rand-hex-32"
