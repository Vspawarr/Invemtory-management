# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used only for admin bootstrap scripts / trusted server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build shareable /live/[matchId] links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
